{
    "name": "angular-component-library-p",
    "version": "4.0.2",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "build:prod": "ng build --configuration production",
        "build:lib": "ng build angular-component-library --configuration production",
        "build:lib-watch": "ng build angular-component-library --configuration production --watch",
        "pack:lib": "cd dist/angular-component-library && npm pack",
        "link:lib": "cd dist/angular-component-library && npm link",
        "test": "ng test",
        "lint": "ng lint",
        "prettier": "npx prettier --write .",
        "prettier:check": "prettier --check .",
        "storybook": "ng run angular-component-library:storybook",
        "test-storybook": "test-storybook --config-dir projects/angular-component-library/.storybook --url http://localhost:6006",
        "build-storybook": "ng run angular-component-library:build-storybook",
        "pipeline:update-all": "node update-all.js",
        "sync:lib": "node sync-versions.js && ng build angular-component-library --configuration production",
        "update:devkit": "ng update @angular-devkit/build-angular@21.2.11",
        "update:angular": "ng update @angular/cli@21 @angular/core@21",
        "update:angular/cdk": "ng update @angular/cdk@21 @ngx-translate/core",
        "update:fortawesome": "ng update @fortawesome/angular-fontawesome @fortawesome/fontawesome-svg-core @fortawesome/free-brands-svg-icons @fortawesome/free-regular-svg-icons @fortawesome/free-solid-svg-icons",
        "update:util": "ng update date-fns @types/lodash.clonedeep lodash.clonedeep luxon @types/luxon rxjs tslib zone.js prettier ng-packagr playwright",
        "update:karma": "ng update karma karma-chrome-launcher karma-coverage karma-jasmine karma-jasmine-html-reporter",
        "update:storybook": "ng update @storybook/angular@^10 storybook@^10 @storybook/addon-docs@^10 @storybook/addon-onboarding@^10 @storybook/test-runner storybook-design-token @compodoc/compodoc"
    },
    "private": true,
    "dependencies": {
        "@angular/animations": "^22.2.4",
        "@angular/cdk": "^22.2.5",
        "@angular/common": "^22.2.4",
        "@angular/compiler": "^22.2.4",
        "@angular/core": "^22.2.4",
        "@angular/forms": "^22.2.4",
        "@angular/platform-browser": "^22.2.4",
        "@angular/platform-browser-dynamic": "^22.2.4",
        "@angular/router": "^22.2.4",
        "@fortawesome/angular-fontawesome": "^5.1.0",
        "@fortawesome/fontawesome-svg-core": "^7.3.1",
        "@fortawesome/free-brands-svg-icons": "^7.2.0",
        "@fortawesome/free-regular-svg-icons": "^7.2.0",
        "@fortawesome/free-solid-svg-icons": "^7.2.0",
        "@ngx-translate/core": "^17.0.0",
        "@storybook/addon-a11y": "^10.3.6",
        "@storybook/builder-webpack5": "^10.3.6",
        "@types/lodash.clonedeep": "^4.5.9",
        "@types/luxon": "^3.7.1",
        "date-fns": "^4.1.0",
        "lodash.clonedeep": "^4.5.0",
        "luxon": "^3.7.2",
        "rxjs": "~7.8.2",
        "storybook-design-token": "^5.0.0",
        "tslib": "^2.8.1",
        "upgrade": "^1.1.0",
        "zone.js": "~0.16.2"
    },
    "devDependencies": {
        "@angular-devkit/build-angular": "^22.2.5",
        "@angular-devkit/core": "^22.2.5",
        "@angular-eslint/builder": "^22.6.0",
        "@angular/build": "^22.2.5",
        "@angular/cli": "^22.2.5",
        "@angular/compiler-cli": "^22.2.4",
        "@compodoc/compodoc": "^1.2.1",
        "@eslint/js": "^9.39.4",
        "@storybook/addon-docs": "^10.3.6",
        "@storybook/addon-onboarding": "^10.3.6",
        "@storybook/angular": "^10.6.5",
        "@storybook/test-runner": "^0.24.3",
        "@types/jasmine": "~5.1.0",
        "@types/webpack": "^5.28.5",
        "angular-eslint": "^22.6.0",
        "eslint": "^9.39.4",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-storybook": "10.3.6",
        "istanbul-lib-instrument": "^6.0.3",
        "jasmine-core": "~5.1.0",
        "karma": "~6.4.3",
        "karma-chrome-launcher": "~3.2.0",
        "karma-coverage": "~2.2.0",
        "karma-jasmine": "~5.1.0",
        "karma-jasmine-html-reporter": "~2.2.0",
        "ng-packagr": "^22.2.5",
        "playwright": "^1.60.0",
        "prettier": "^3.8.3",
        "storybook": "^10.6.5",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.48.1"
    },
    "overrides": {
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "picomatch": "^4.0.3",
        "uuid": "^11.1.0"
    }
}
